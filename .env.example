# 复制成 .env 再改。不填任何一项也能跑：默认 mock 模型 + 本地 RAG 桩。
# 所有变量只在 src/mineclearance/config.py 里读一次，别处不出现字面量。

# ---- 模型 ----
# mock / openai_compat
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
# 决策档：只吃抽取表，不吃学生原文，选便宜的小模型
DECISION_MODEL=
# 推理档：升级判级与出题埋雷
REASONING_MODEL=

# 对抗方：单独一家厂商。留空则复用推理档，会话照常跑，
# 但 /v1/health 的 vendor_isolated 会是 false——判级复核等于自己查自己。
ADVERSARY_API_BASE=
ADVERSARY_API_KEY=
ADVERSARY_MODEL=

# ---- 检索 ----
# 留空 = 用本地桩 LocalStubRAG；填写后走 HTTP，契约见 docs/rag-api.md
RAG_BASE_URL=
RAG_API_KEY=
RAG_TIMEOUT_S=2.0
# 召回多少条（进裁判前会在本地截到 rag_judge_top_k）
RAG_TOP_K=10
RAG_JUDGE_TOP_K=3

# ---- 裁决层（状态机 / 两段式预算 / 锚点）----
# 留空 = 内存实现 FakeUpstream，/v1/stage 与 /v1/budget/* 照常可用；
# 填上就整体切到 HttpUpstream，契约见 docs/upstream-api.md。
# 注意：这里不做降级。裁决权只有一份，本地再算一遍等于两边各说各话。
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_S=3.0
# 锚点只对内部开放。留空 = /v1/anchor/* 一律 403。
MC_INTERNAL_TOKEN=

# ---- 预算（申报表里的硬上限，别在这里放大）----
MAX_CALLS_PER_SESSION=12
COST_BUDGET_CNY=0.08

# ---- 对抗轮次 ----
MIN_ROUNDS=2
MAX_ROUNDS=3
# 决策层置信度低于此值时升级一次（标定前先按 0.8，标定后冻结）
ESCALATE_CONFIDENCE=0.8

# ---- 其他 ----
PREFETCH=true
ITEMS_PER_SESSION=3

# ---- Web 层 ----
# 1/true 打开真实探针（会执行模型写出的代码来复核「雷是否埋上」）。
# mock 模式自动用 MarkerProbe，不需要这个开关。
MC_PROBE=0
# 前端来源，逗号分隔
MC_CORS_ORIGINS=http://localhost:5173
